# Binary / generated files that crash Codacy's UTF-8 parser
docs/*.png
sim/graphs/*.png
outputs/

# Runtime data (already gitignored, but belt-and-suspenders)
data/
data4/
smoke_data/

# Caches and build artifacts
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Binary formats Codacy should never try to parse
*.npy
*.npz
*.pkl
*.pt
*.bin
*.db
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
