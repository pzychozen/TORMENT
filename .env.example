# =====================================================================
# .env template for the TORMENT Character Truth Bench
#
# 1. Copy this file to torment_fabric/.env
# 2. Fill in the keys you actually have.
# 3. The bench runner auto-loads torment_fabric/.env at startup.
#
# .env is gitignored (see .gitignore). Never commit it.
# =====================================================================

# --- TORMENT server (started in another cmd window via `python -m torment_service`) ---
TORMENT_SERVER_URL=http://127.0.0.1:8787

# --- Anthropic (direct, recommended for Claude models) ---
ANTHROPIC_API_KEY=sk-REPLACE_ME

# --- OpenRouter (one key, many underlying models) ---
# Sign up at https://openrouter.ai, browse models at https://openrouter.ai/models
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# --- Optional: direct OpenAI (skip if you're routing through OpenRouter) ---
# OPENAI_API_KEY=sk-REPLACE_ME

# --- Which provider:model pairs the bench should run (comma-separated) ---
# OpenRouter slugs are namespaced: provider/model[:variant]
# Examples (model availability changes; check https://openrouter.ai/models):
#   openrouter:google/gemini-2.5-flash
#   openrouter:google/gemini-2.0-flash-exp
#   openrouter:gryphe/mythomax-l2-13b
#   openrouter:mistralai/mistral-7b-instruct
#   openrouter:anthropic/claude-sonnet-4-6    (Claude via OpenRouter, billed via OR)
#   anthropic:claude-sonnet-4-6               (Claude direct, billed via Anthropic)
TORMENT_BENCH_MODELS=anthropic:claude-sonnet-4-6,openrouter:google/gemini-2.5-flash

# --- Toggles ---
# TORMENT_TRUTH_BENCH_RUNS overrides matrix runs_per_cell at run time.
# TORMENT_TRUTH_BENCH_RUNS=3
